<Chaste>

	<OnLatticeSimulation-2>
		<Dt>0.01</Dt>
		<EndTime>10</EndTime>
		<UpdateCellPopulation>1</UpdateCellPopulation>
		<SamplingTimestepMultiple>100</SamplingTimestepMultiple>
		<UpdatingTimestepMultiple>1</UpdatingTimestepMultiple>
		<OutputDivisionLocations>0</OutputDivisionLocations>
		<OutputCellVelocities>0</OutputCellVelocities>
	</OnLatticeSimulation-2>

	<CaBasedCellPopulation-2>
		<CaBasedDivisionRule>
			<ShovingCaBasedDivisionRule-2>
			</ShovingCaBasedDivisionRule-2>
		</CaBasedDivisionRule>
		<UpdateNodesInRandomOrder>1</UpdateNodesInRandomOrder>
		<IterateRandomlyOverUpdateRuleCollection>0</IterateRandomlyOverUpdateRuleCollection>
		<OutputResultsForChasteVisualizer>1</OutputResultsForChasteVisualizer>
	</CaBasedCellPopulation-2>

	<CellCycleModels>
		<UniformG1GenerationalCellCycleModel>
			<MaxTransitGenerations>3</MaxTransitGenerations>
			<StemCellG1Duration>14</StemCellG1Duration>
			<TransitCellG1Duration>2</TransitCellG1Duration>
			<SDuration>5</SDuration>
			<G2Duration>4</G2Duration>
			<MDuration>1</MDuration>
		</UniformG1GenerationalCellCycleModel>
	</CellCycleModels>

	<SrnModels>
		<NullSrnModel>
		</NullSrnModel>
	</SrnModels>

	<CellKillers>
	</CellKillers>

	<SimulationModifiers>
	</SimulationModifiers>

	<UpdateRules>
		<DifferentialAdhesionCaSwitchingUpdateRule-2>
			<CellCellAdhesionEnergyParameter>0.1</CellCellAdhesionEnergyParameter>
			<LabelledCellLabelledCellAdhesionEnergyParameter>0.1</LabelledCellLabelledCellAdhesionEnergyParameter>
			<LabelledCellCellAdhesionEnergyParameter>0.2</LabelledCellCellAdhesionEnergyParameter>
			<CellBoundaryAdhesionEnergyParameter>0.2</CellBoundaryAdhesionEnergyParameter>
			<LabelledCellBoundaryAdhesionEnergyParameter>0.4</LabelledCellBoundaryAdhesionEnergyParameter>
			<Temperature>0.1</Temperature>
		</DifferentialAdhesionCaSwitchingUpdateRule-2>
	</UpdateRules>

</Chaste>
